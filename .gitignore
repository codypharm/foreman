# impeccable skill: platform binary (18 MB, macOS arm64 only). The launcher
# downloads and checksum-verifies the right binary when it is missing.
.claude/skills/impeccable/scripts/bin/

# Secrets: names only go in .env.example (see CLAUDE.md, "Security first")
.env
.env.*
!.env.example

# macOS
.DS_Store

# Personal Claude Code permissions (blanket Bash allow); not shared
.claude/settings.json

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# impeccable working files (draft mocks, decision pages, hook cache); chosen mocks go in docs/mocks
.impeccable/*
!.impeccable/config.json

# Foundry build output
contracts/out/
contracts/cache/
contracts/broadcast/

# The publish job's dry-run plans (apps/api): large, rebuilt on every run
data/publish-plan-*.json

# Database dumps (docs/deploy.md): copies of the index, never committed
*.dump

# FabX log backfill (packages/chain-xlayer): large, re-read from chain
data/fabx-logs-*.jsonl
