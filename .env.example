# Names only. Copy to .env (gitignored) and fill in. Never commit a real value.

# BNB Smart Chain archive RPC URL: reads and logs more than 5,000 blocks behind the head, and reads
# by hash (docs/decisions/2026-11-21-bnb-nodes.md). Alchemy from 21 Nov 2026; NodeReal again on 23 Nov 2026.
BNB_ARCHIVE_RPC_URL=
# Optional: the node for reads and logs within 5,000 blocks of the head. Defaults to
# bsc-rpc.publicnode.com.
BNB_RECENT_RPC_URL=

# Optional: blocks per log read on the archive node. 10 (Alchemy free tier) when not set;
# 50000 for NodeReal.
BNB_ARCHIVE_LOG_BLOCKS=

# Local Postgres from docker-compose.yml (docs/decisions/2026-11-20-database-access.md).
# The index: postgres://foreman:foreman-local@127.0.0.1:54320/foreman
DATABASE_URL=
# Storage tests wipe this database, so its name must end in _test:
# postgres://foreman:foreman-local@127.0.0.1:54320/foreman_test
TEST_DATABASE_URL=

# The publish job (apps/api, docs/decisions/2026-11-21-publish-job.md). Only for `--send`, and set
# for that run only: the dedicated publisher wallet's key. Never put it in this file or in .env.
# PUBLISHER_KEY=
# Optional: an X Layer RPC other than the public one in contracts/foundry.toml. The publisher's
# (the testnet, for the worker); never used for FabX's reads.
XLAYER_RPC_URL=
# Optional: an X Layer mainnet RPC for FabX's reads (the worker's FabX follow and the FabX scripts),
# tried before the three public nodes (docs/decisions/2026-11-26-fabx-follow.md, decision 2).
XLAYER_MAINNET_RPC_URL=
# Set to 1 to publish FabX miners' results with the BNB Chain ones (the worker and publish-results).
# Off unless set (docs/decisions/2026-11-26-fabx-publishing.md).
PUBLISH_FABX=
