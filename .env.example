# Names only. Copy to .env (gitignored) and fill in. Never commit a real value.

# BNB Smart Chain archive RPC URL, for backfilling network history (packages/chain-bnb).
# The public node serves state only a few hours back. Any provider with BNB archive works.
BNB_ARCHIVE_RPC_URL=

# Local Postgres from docker-compose.yml (docs/decisions/2026-11-20-database-access.md).
# The index: postgres://foreman:foreman-local@127.0.0.1:54320/foreman
DATABASE_URL=
# Storage tests wipe this database, so its name must end in _test:
# postgres://foreman:foreman-local@127.0.0.1:54320/foreman_test
TEST_DATABASE_URL=

# The publish job (apps/api, docs/decisions/2026-11-21-publish-job.md). Only for `--send`, and set
# for that run only: the dedicated publisher wallet's key. Never put it in this file or in .env.
# PUBLISHER_KEY=
# Optional: an X Layer RPC other than the public one in contracts/foundry.toml.
XLAYER_RPC_URL=
