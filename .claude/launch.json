{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@siteproof/backend",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@siteproof/backend",
        "exec",
        "prisma",
        "studio",
        "--browser",
        "none",
        "--port",
        "5555"
      ],
      "port": 5555
    },
    {
      "name": "foreman-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgres://foreman:foreman-local@127.0.0.1:54320/foreman",
        "BNB_ARCHIVE_LOG_BLOCKS=50000",
        "PORT=8787",
        "pnpm",
        "--filter",
        "@foreman/api",
        "serve"
      ],
      "port": 8787
    },
    {
      "name": "foreman-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@foreman/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "foreman-web-dev-wallet",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_DEV_WALLET=0x077ea6b4c1dfc7f7ec253d736c56898dfc192ea5",
        "pnpm",
        "--filter",
        "@foreman/web",
        "dev",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}
