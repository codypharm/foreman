		"@foreman/chain-bnb": "workspace:*",
		"@foreman/chain-xlayer": "workspace:*",
		"@foreman/contract": "workspace:*",
		"@foreman/originality": "workspace:*",
		"@foreman/valuation": "workspace:*",
		"pg": "^8.23.1",
		"viem": "2.57.16"
