{
	"name": "@foreman/chain-xlayer",
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./results": "./src/results.ts",
		"./pro": "./src/pro.ts",
		"./fixtures/*": "./fixtures/*"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p .",
		"record:lend": "node --env-file-if-exists=../../.env scripts/record-lend-fixture.ts",
		"record:lend-fork": "node scripts/record-lend-fork-fixture.ts",
		"record:lend-live-fork": "node scripts/record-lend-live-fork-fixture.ts",
		"record:held-vouchers": "node scripts/record-held-vouchers-fixture.ts",
		"record:voucher-circuit": "node scripts/record-voucher-circuit-fixture.ts",
		"record:published-result": "node scripts/record-published-result-fixture.ts",
		"backfill:fabx-logs": "node --env-file-if-exists=../../.env scripts/backfill-fabx-logs.ts",
		"record:fabx-miners": "node --env-file-if-exists=../../.env scripts/record-fabx-miners-fixture.ts"
	},
	"dependencies": {
		"@foreman/chain-bnb": "workspace:*",
		"@foreman/contract": "workspace:*",
		"viem": "2.57.16"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"vitest": "^5.1.0"
	}
}
