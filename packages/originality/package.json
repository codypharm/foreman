	},
	"dependencies": {
		"@foreman/chain-bnb": "workspace:*",
		"@foreman/contract": "workspace:*",
		"viem": "2.57.16"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"vitest": "^5.1.0"
	}
}
