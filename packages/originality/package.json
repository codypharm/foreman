{
	"name": "@foreman/originality",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./fixtures/*": "./fixtures/*"
	},
	"scripts": {
		"test": "vitest run --passWithNoTests",
